{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartestate-api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "smartestate-marketing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/marketing", "run", "dev"],
      "port": 5173
    },
    {
      "name": "smartestate-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/dashboard", "run", "dev"],
      "port": 5174
    }
  ]
}
