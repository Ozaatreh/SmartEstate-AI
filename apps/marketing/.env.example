# Marketing website (Vite). Copy to apps/marketing/.env.local — never commit real values.
#
# Google Maps JavaScript API browser key for the project location map (optional). Without it the site shows a text
# fallback plus "Get directions" / "Open in Google Maps" links, which need no key.
# This is a *browser* key: it is visible in the page by design. Restrict it in Google Cloud Console to
#   - API restrictions: "Maps JavaScript API" only
#   - Application restriction: Websites (HTTP referrers) = your site's domains (e.g. https://www.example.com/*)
# A Google "Maps Demo Key" works for the map (prototyping only, not production). See docs/MAPS.md.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (needed for the map pin / Advanced Markers). DEMO_MAP_ID is Google's demo Map ID; create your own for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Street View: "enabled" only with a key on a Google Cloud project with billing — the Maps Demo Key does not include it.
VITE_GOOGLE_MAPS_STREET_VIEW=disabled
