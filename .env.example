# SmartEstate AI — environment template. Copy to .env and replace every <placeholder>.
# .env is git-ignored. Never commit real credentials.

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (PostgreSQL 16+) ---------------------------------------------
# The dev cluster script (infrastructure/scripts/dev-db.sh) uses these values.
# use 127.0.0.1, not localhost (IPv6 delay on Windows)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=smartestate
DB_PASSWORD=<generate: python -c "import secrets; print(secrets.token_urlsafe(24))">
DATABASE_URL=postgresql+psycopg://smartestate:<DB_PASSWORD>@127.0.0.1:5434/smartestate
# Must end in _test — the test suite refuses any other database.
TEST_DATABASE_URL=postgresql+psycopg://smartestate:<DB_PASSWORD>@127.0.0.1:5434/smartestate_test

# --- Security -----------------------------------------------------------------
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
SESSION_TTL_MINUTES=480
# empty = automatic (on outside development/test)
COOKIE_SECURE=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_FAILURES=30
LOGIN_IP_WINDOW_MINUTES=15

# --- Seed (development only) --------------------------------------------------
SEED_ADMIN_EMAIL=admin@smartestate.demo
# Password shared by all seeded demo accounts (development only).
SEED_DEMO_PASSWORD=<generate: python -c "import secrets; print(secrets.token_urlsafe(12))">

# --- AI (Claude API) — the app always starts, whatever these values are -------
# AI features stay off unless AI_ENABLED=true AND a key is set (paid API calls).
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5
# Gateway limits (optional; invalid values disable AI, never the app):
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
AI_DAILY_COST_CAP_USD=10
# Per-agent overrides (optional): AI_MODEL_<FEATURE>, AI_EFFORT_<FEATURE>
# e.g. AI_MODEL_PROPERTY_ASSISTANT=claude-opus-5-5
# Marketing Studio AI generation (Phase 7); separate from AI_ENABLED so other AI features keep working.
AI_MARKETING_STUDIO_ENABLED=false

# Brochures & posters (Phase 7C). Contact details are printed only when set — leave blank to omit them.
COLLATERAL_CONTACT_PHONE=
COLLATERAL_CONTACT_EMAIL=
COLLATERAL_WEBSITE_URL=
# Approved project images live here (relative to apps/api); see docs/MARKETING_ASSETS.md.
COLLATERAL_MEDIA_DIR=var/media

# 3D property models (Phase 7E). Files are stored here (relative to apps/api); see docs/3D_MODELS.md.
MODEL_STORAGE_DIR=var/models
MODEL_MAX_UPLOAD_MB=50
